@page
@model BookInfoFinder.Pages.IndexModel
@{
    ViewData["Title"] = "Khám phá sách";
}
<div class="discovery-layout">
    <section class="discovery-content" aria-label="Khám phá sách">
        <nav class="discovery-tabs" aria-label="Bộ sưu tập sách">
            <a asp-page="/Index" data-collection="" class="active">Khám phá</a>
            <a asp-page="/Index" asp-route-filter="top-rated" data-collection="top-rated">Đánh giá cao</a>
            <a asp-page="/Index" asp-route-filter="trending" data-collection="trending">Được yêu thích</a>
        </nav>
        <div class="discovery-intro"><div><p class="intro-greeting">Dành một chút thời gian cho sách</p><h1>Cuốn sách tiếp theo<br />của bạn ở đây.</h1><p>Từ một câu chuyện mới đến một điều bạn muốn hiểu.<br class="desktop-break" /> Khám phá thư viện theo cách của bạn.</p></div><div class="book-scene" aria-hidden="true"><span class="scene-circle"></span><div class="scene-book book-back">MỞ MỘT<br />TRANG MỚI</div><div class="scene-book book-front"><i class="bi bi-sun"></i><span>Những<br />chân trời<br />rộng mở</span><small>BookInfoFinder</small></div><span class="scene-spark">✧</span></div></div>
        <form id="mainSearchForm" class="discovery-search" role="search">
            <label class="visually-hidden" for="mainSearchInput">Tìm sách, tác giả hoặc thể loại</label>
            <div class="discovery-search-field"><i class="bi bi-search" aria-hidden="true"></i><input type="search" id="mainSearchInput" name="q" placeholder="Tìm sách, tác giả hoặc thể loại…" autocomplete="off" aria-controls="searchSuggestions" aria-expanded="false" /><button class="button-primary" type="submit">Tìm sách</button></div>
            <div id="searchSuggestions" class="search-suggestions" aria-label="Gợi ý tìm kiếm" hidden></div>
        </form>
        <div class="discovery-toolbar"><div><h2 id="collectionTitle">Khám phá thư viện</h2><p id="resultSummary" role="status" aria-live="polite">Đang tìm những cuốn sách dành cho bạn…</p></div><div class="sort-control"><label for="bookSort">Sắp xếp</label><select id="bookSort" name="sort"><option value="">Mặc định</option><option value="year">Mới xuất bản</option><option value="rating">Đánh giá cao</option><option value="favorites">Yêu thích nhiều</option><option value="title">Tên sách A–Z</option></select></div></div>
        <div id="loadingState" class="loading"><div class="spinner"></div><span>Đang tải sách…</span></div>
        <div id="bookList" class="book-grid discovery-books" aria-label="Danh sách sách"></div>
        <div id="emptyState" class="discovery-empty" hidden><i class="bi bi-search" aria-hidden="true"></i><h3>Chưa tìm thấy cuốn sách phù hợp</h3><p>Thử một từ khóa ngắn hơn hoặc khám phá tất cả sách trong thư viện.</p><button id="clearSearch" class="button-primary" type="button">Xem tất cả sách</button></div>
        <div id="searchError" class="discovery-empty" role="alert" hidden><i class="bi bi-wifi-off" aria-hidden="true"></i><h3>Chưa tải được thư viện</h3><p>Kiểm tra kết nối rồi thử tải lại danh sách sách.</p><button id="retrySearch" class="button-primary" type="button">Thử lại</button></div>
        <nav id="paginationNav" class="pagination-container" aria-label="Trang kết quả" hidden><ul class="pagination" id="paginationButtons"></ul></nav>
        <div class="reading-banner"><span class="banner-icon"><i class="bi bi-bookmark-heart" aria-hidden="true"></i></span><div><h2>Giữ lại những cuốn sách bạn thích.</h2><p>Một tủ sách riêng, luôn sẵn sàng cho lần đọc tiếp theo.</p></div><a asp-page="/Favorites">Tủ sách của bạn <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a></div>
    </section>
    <aside class="discovery-aside" aria-label="Gợi ý khám phá">
        <section class="aside-section"><div class="aside-heading"><h2>Một chút cảm hứng</h2><i class="bi bi-quote" aria-hidden="true"></i></div><blockquote>Hôm nay, bạn muốn tìm thấy điều gì trong một cuốn sách?</blockquote><p>Một câu chuyện để đắm mình. Một ý tưởng để bắt đầu. Hay một góc nhìn để hiểu hơn.</p></section>
        <section class="aside-section"><h2>Khám phá theo thẻ</h2><div class="discovery-tags">@if (Model.Tags.Count > 0) { foreach (var tag in Model.Tags.Take(10)) { <a asp-page="/Index" asp-route-tag="@tag.Name">@tag.Name</a> } } else { <p>Thẻ sách sẽ xuất hiện khi thư viện có nội dung.</p> }</div></section>
        <section class="reading-note"><i class="bi bi-cup-hot" aria-hidden="true"></i><h2>Chậm lại một trang.</h2><p>Chọn một cuốn sách, dành một khoảng lặng và để trí tò mò dẫn đường.</p><a asp-page="/Index" asp-route-filter="top-rated">Tìm sách được đánh giá cao <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a></section>
        <section class="aside-section guide-section"><h2>Thư viện trong tầm tay</h2><a asp-page="/Favorites"><i class="bi bi-heart" aria-hidden="true"></i><span>Lưu sách yêu thích<small>Quay lại bất cứ khi nào bạn muốn</small></span></a><a asp-page="/SearchHistory"><i class="bi bi-clock-history" aria-hidden="true"></i><span>Tiếp tục tìm kiếm<small>Xem lại những lần khám phá trước</small></span></a><button type="button" onclick="toggleChatbotModal()"><i class="bi bi-chat-dots" aria-hidden="true"></i><span>Hỏi trợ lý tìm sách<small>Bắt đầu từ điều bạn quan tâm</small></span></button></section>
    </aside>
</div>
@section Scripts { <script src="~/js/index.js" asp-append-version="true"></script> }
