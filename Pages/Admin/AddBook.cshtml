@page
@model BookInfoFinder.Pages.Admin.AddBookModel
@{
    ViewData["Title"] = "Thêm sách mới";
    ViewData["Description"] = "Đưa một cuốn sách mới đến gần hơn với người đọc.";
    var editor = new BookInfoFinder.Models.View.BookEditorViewModel {
        Book = new BookInfoFinder.Models.Dto.BookUpdateDto {
            Title = Model.Book.Title, ISBN = Model.Book.ISBN, Description = Model.Book.Description,
            Abstract = Model.Book.Abstract, AuthorId = Model.Book.AuthorId, CategoryId = Model.Book.CategoryId,
            PublisherId = Model.Book.PublisherId, ImageBase64 = Model.Book.ImageBase64,
            PublicationDate = Model.Book.PublicationDate == default ? DateTime.UtcNow.AddHours(7).Date : Model.Book.PublicationDate
        },
        Authors = Model.Authors, Categories = Model.Categories, Publishers = Model.Publishers,
        Tags = Model.Tags, SelectedTagIds = Model.SelectedTagIds
    };
}
@section PageActions { <a class="admin-button secondary" asp-page="/Admin/ManageBook"><i class="bi bi-arrow-left" aria-hidden="true"></i> Về danh mục sách</a> }
<partial name="_BookEditor" model="editor" />
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/admin-book-editor.js" asp-append-version="true"></script> }
