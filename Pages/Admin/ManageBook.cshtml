@page
@model BookInfoFinder.Pages.Admin.ManageBookModel
@{
    ViewData["Title"] = "Danh mục sách";
    ViewData["Description"] = "Thêm, cập nhật và sắp xếp những cuốn sách trong thư viện.";
}
@section PageActions {
    <form method="post" asp-page-handler="ExportCsv" id="exportCsvForm"><input type="hidden" name="Search" id="csvSearch" /><input type="hidden" name="Category" id="csvCategory" /><button type="submit" class="admin-button secondary"><i class="bi bi-download" aria-hidden="true"></i> Xuất CSV</button></form>
    <a class="admin-button primary" asp-page="/Admin/AddBook"><i class="bi bi-plus-lg" aria-hidden="true"></i> Thêm sách</a>
}
<section class="admin-panel">
    <div class="panel-heading slim"><h2>Thư viện sách</h2><span id="bookTotal" class="table-meta" role="status" aria-live="polite">Đang tải…</span></div>
    <form id="bookSearchForm" class="table-toolbar" role="search">
        <label class="admin-search"><i class="bi bi-search" aria-hidden="true"></i><span class="visually-hidden">Tìm sách trong danh mục</span><input type="search" name="search" id="bookSearch" placeholder="Tìm tên sách…" autocomplete="off" /></label>
        <select id="bookCategory" name="category" aria-label="Lọc theo thể loại"><option value="">Tất cả thể loại</option>@foreach (var category in Model.Categories) { <option value="@category.CategoryId">@category.Name</option> }</select>
        <button class="admin-button secondary" type="submit">Tìm kiếm</button><button class="admin-button text" id="bookReset" type="button">Xóa bộ lọc</button>
    </form>
    <div id="adminBooksTable" aria-busy="true"><div class="admin-empty">Đang tải danh sách sách…</div></div>
    <div class="table-footer"><span id="bookSummary">Danh mục sách</span><nav id="bookPagination" class="admin-pagination" aria-label="Trang danh sách sách"></nav></div>
</section>
@section Scripts { <script src="~/js/admin-books.js" asp-append-version="true"></script> }
