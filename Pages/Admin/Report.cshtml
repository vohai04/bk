@page
@model BookInfoFinder.Pages.Admin.ReportModel
@{
    ViewData["Title"] = "Báo cáo thư viện";
    ViewData["Description"] = "Hiểu cấu trúc nội dung qua những con số và phân bố thực tế.";
}
@section PageActions {
    <button class="admin-button secondary" id="refreshReport" type="button"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Làm mới</button>
    <form method="post" asp-page-handler="ExportTodayPdf" class="report-export" id="reportExportForm"><select name="period" id="reportPeriod" aria-label="Khoảng thời gian báo cáo"><option value="Today">Hôm nay</option><option value="Week">Tuần này</option><option value="Month">Tháng này</option><option value="Year">Năm nay</option></select><button class="admin-button primary" type="submit"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> Xuất PDF</button></form>
}
<div id="reportStatus" class="table-meta" role="status" aria-live="polite">Đang tải báo cáo…</div>
<div class="report-metrics">
    <div><span>Sách</span><strong data-stat="totalBooks">—</strong></div><div><span>Tác giả</span><strong data-stat="totalAuthors">—</strong></div><div><span>Thể loại</span><strong data-stat="totalCategories">—</strong></div><div><span>Nhà xuất bản</span><strong data-stat="totalPublishers">—</strong></div><div><span>Người dùng</span><strong data-stat="totalUsers">—</strong></div><div><span>Thẻ sách</span><strong data-stat="totalTags">—</strong></div>
</div>
<div class="report-charts">
    <section class="admin-panel"><div class="panel-heading"><div><h2>Sách theo năm xuất bản</h2><p>Các giai đoạn xuất bản trong thư viện.</p></div><i class="bi bi-calendar3" aria-hidden="true"></i></div><div class="report-distribution" id="report_yearData"></div></section>
    <section class="admin-panel"><div class="panel-heading"><div><h2>Sách theo thể loại</h2><p>Những chủ đề đang có nhiều đầu sách.</p></div><i class="bi bi-collection" aria-hidden="true"></i></div><div class="report-distribution" id="report_categoryData"></div></section>
    <section class="admin-panel"><div class="panel-heading"><div><h2>Tác giả trong thư viện</h2><p>Tối đa 10 tác giả có nhiều sách nhất.</p></div><i class="bi bi-person-badge" aria-hidden="true"></i></div><div class="report-distribution" id="report_authorData"></div></section>
    <section class="admin-panel"><div class="panel-heading"><div><h2>Nhà xuất bản</h2><p>Số đầu sách theo từng đơn vị xuất bản.</p></div><i class="bi bi-buildings" aria-hidden="true"></i></div><div class="report-distribution" id="report_publisherData"></div></section>
</div>
@section Scripts { <script src="~/js/admin-report.js" asp-append-version="true"></script> }
