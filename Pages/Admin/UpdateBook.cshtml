@page "{id:int}"
@model BookInfoFinder.Pages.Admin.UpdateBookModel
@{
    ViewData["Title"] = "Chỉnh sửa sách";
    ViewData["Description"] = "Cập nhật thông tin và giữ nội dung thư viện luôn đầy đủ.";
    var editor = new BookInfoFinder.Models.View.BookEditorViewModel {
        Book = Model.Book, Authors = Model.Authors, Categories = Model.Categories,
        Publishers = Model.Publishers, Tags = Model.Tags, SelectedTagIds = Model.SelectedTagIds
    };
}
@section PageActions { <a class="admin-button secondary" asp-page="/Admin/ManageBook" asp-route-search="@Model.Search" asp-route-category="@Model.Category"><i class="bi bi-arrow-left" aria-hidden="true"></i> Về danh mục sách</a> }
<partial name="_BookEditor" model="editor" />
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/admin-book-editor.js" asp-append-version="true"></script> }
