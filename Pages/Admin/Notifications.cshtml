@page
@model BookInfoFinder.Pages.Admin.NotificationsModel
@{
    ViewData["Title"] = "Thông báo";
    ViewData["Description"] = "Theo dõi những cập nhật dành cho tài khoản của bạn.";
}
@section PageActions { <form method="post" asp-page-handler="ReadAll"><input type="hidden" name="UnreadOnly" value="@Model.UnreadOnly.ToString().ToLowerInvariant()" /><button class="admin-button secondary" type="submit"><i class="bi bi-check2-all" aria-hidden="true"></i> Đánh dấu đã đọc</button></form> }
<section class="admin-panel">
    <nav class="admin-list-tabs" aria-label="Lọc thông báo"><a asp-page="/Admin/Notifications" class="@(!Model.UnreadOnly ? "active" : "")">Tất cả <span>@Model.Total</span></a><a asp-page="/Admin/Notifications" asp-route-unreadOnly="true" class="@(Model.UnreadOnly ? "active" : "")">Chưa đọc <span>@Model.UnreadCount</span></a></nav>
    @if (Model.Items.Count == 0) { <div class="admin-empty"><i class="bi bi-bell" aria-hidden="true"></i><h2>Chưa có thông báo</h2><p>Các cập nhật mới dành cho bạn sẽ xuất hiện ở đây.</p></div> }
    @foreach (var item in Model.Items)
    {
        <article class="admin-notification @(!item.IsRead ? "unread" : "")"><span class="notification-symbol"><i class="bi bi-bell" aria-hidden="true"></i></span><div><h2>@item.Title</h2><p>@item.Message</p><time datetime="@item.CreatedAt.ToString("O")" data-format="datetime">@item.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</time>@if (item.RelatedEntityType?.Equals("Book", StringComparison.OrdinalIgnoreCase) == true && item.RelatedEntityId.HasValue) { <a asp-page="/BookDetail" asp-route-id="@item.RelatedEntityId">Xem sách</a> }</div>@if (!item.IsRead) { <form method="post" asp-page-handler="Read"><input type="hidden" name="UnreadOnly" value="@Model.UnreadOnly.ToString().ToLowerInvariant()" /><input type="hidden" name="p" value="@Model.CurrentPage" /><input type="hidden" name="notificationId" value="@item.NotificationId" /><button class="row-action" type="submit" aria-label="Đánh dấu đã đọc: @item.Title"><i class="bi bi-check2" aria-hidden="true"></i></button></form> }</article>
    }
    <div class="table-footer"><span>@Model.Total thông báo</span><nav class="admin-pagination" aria-label="Trang thông báo">@if(Model.CurrentPage > 1) { <a asp-page="/Admin/Notifications" asp-route-p="@(Model.CurrentPage-1)" asp-route-unreadOnly="@Model.UnreadOnly">Trước</a> }<span>@Model.CurrentPage / @Math.Max(1, Model.TotalPages)</span>@if(Model.CurrentPage < Model.TotalPages) { <a asp-page="/Admin/Notifications" asp-route-p="@(Model.CurrentPage+1)" asp-route-unreadOnly="@Model.UnreadOnly">Sau</a> }</nav></div>
</section>
