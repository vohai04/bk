@page
@model BookInfoFinder.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Tổng quan thư viện";
    ViewData["Description"] = "Một góc nhìn rõ ràng để chăm sóc nội dung và người đọc.";
}
@section PageActions {
    <a class="admin-button secondary" asp-page="/Admin/Report"><i class="bi bi-bar-chart" aria-hidden="true"></i> Xem báo cáo</a>
    <a class="admin-button primary" asp-page="/Admin/AddBook"><i class="bi bi-plus-lg" aria-hidden="true"></i> Thêm sách</a>
}
@if (Model.LoadError is { } error) { <div class="admin-flash error" role="alert">@error</div> }
<div class="overview-welcome">
    <div><span class="welcome-symbol"><i class="bi bi-book" aria-hidden="true"></i></span><h2>Chăm chút cho thư viện.<br />Để mỗi lần tìm kiếm đều có giá trị.</h2><p>Cập nhật nội dung, hoàn thiện thông tin sách và kết nối người đọc với những cuốn sách phù hợp.</p></div>
    <div class="overview-book-art" aria-hidden="true"><span class="art-book art-book-one"><i class="bi bi-flower1"></i><span>Những<br />góc nhìn mới</span></span><span class="art-book art-book-two"><i class="bi bi-brightness-high"></i><span>Mở một<br />trang sách</span></span></div>
</div>
<div class="overview-metrics" aria-label="Thống kê thư viện">
    <a asp-page="/Admin/ManageBook"><i class="bi bi-book" aria-hidden="true"></i><span>Sách trong thư viện<strong>@Model.Stats.TotalBooks</strong></span><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
    <a asp-page="/Admin/Users"><i class="bi bi-people" aria-hidden="true"></i><span>Người dùng<strong>@Model.Stats.TotalUsers</strong></span><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
    <a asp-page="/Admin/Categories"><i class="bi bi-collection" aria-hidden="true"></i><span>Thể loại<strong>@Model.Stats.TotalCategories</strong></span><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
    <a asp-page="/Admin/Report"><i class="bi bi-chat-left-text" aria-hidden="true"></i><span>Đánh giá & bình luận<strong>@Model.Stats.TotalComments</strong></span><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
</div>
<div class="overview-columns">
    <section class="admin-panel">
        <div class="panel-heading"><div><h2>Sách trong thư viện</h2><p>Những đầu sách được thêm gần nhất.</p></div><a asp-page="/Admin/ManageBook">Quản lý tất cả <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a></div>
        @if (Model.Books.Count == 0)
        {
            <div class="admin-empty"><i class="bi bi-book" aria-hidden="true"></i><h3>Thư viện đang chờ cuốn sách đầu tiên</h3><p>Thêm thông tin sách để người đọc bắt đầu khám phá.</p><a class="admin-button primary" asp-page="/Admin/AddBook">Thêm sách</a></div>
        }
        else
        {
            <div class="overview-book-list">
                @foreach (var book in Model.Books)
                {
                    <div class="overview-book-row">
                        <img src="@(string.IsNullOrWhiteSpace(book.Cover) ? "/images/default-book.svg" : book.Cover)" alt="Bìa sách @book.Title" width="38" height="54" loading="lazy" data-cover-fallback />
                        <div class="overview-book-info"><a asp-page="/BookDetail" asp-route-id="@book.Id">@book.Title</a><span>@book.Author</span></div>
                        <span class="admin-pill neutral">@book.Category</span>
                        <a class="row-action" asp-page="/Admin/UpdateBook" asp-route-id="@book.Id" aria-label="Sửa sách @book.Title"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                    </div>
                }
            </div>
        }
        <a class="panel-bottom-link" asp-page="/Admin/AddBook"><i class="bi bi-plus-lg" aria-hidden="true"></i> Thêm một cuốn sách mới</a>
    </section>
    <div class="overview-side">
        <section class="admin-panel">
            <div class="panel-heading"><div><h2>Hoàn thiện thư viện</h2><p>Những thông tin cần được bổ sung.</p></div><i class="bi bi-stars" aria-hidden="true"></i></div>
            <a class="quality-row" asp-page="/Admin/ManageBook"><span><i class="bi bi-image" aria-hidden="true"></i> Sách chưa có ảnh bìa</span><strong>@Model.MissingCovers</strong></a>
            <a class="quality-row" asp-page="/Admin/ManageBook"><span><i class="bi bi-text-paragraph" aria-hidden="true"></i> Sách chưa có tóm tắt</span><strong>@Model.MissingSummaries</strong></a>
            <div class="panel-footnote">Thông tin đầy đủ giúp người đọc chọn sách dễ hơn.</div>
        </section>
        <section class="admin-panel">
            <div class="panel-heading"><div><h2>Sách theo thể loại</h2><p>Phân bố nội dung trong thư viện.</p></div></div>
            <div class="category-distribution">
                @foreach (var category in Model.Categories)
                {
                    var width = Model.Stats.TotalBooks > 0 ? (int)Math.Round(category.Count * 100d / Model.Stats.TotalBooks) : 0;
                    <div><span>@category.Name<strong>@category.Count</strong></span><div class="distribution-track"><div style="width:@(width)%"></div></div></div>
                }
                @if (Model.Categories.Count == 0) { <p class="text-muted">Chưa có thể loại. <a asp-page="/Admin/Categories">Thêm thể loại</a></p> }
            </div>
        </section>
    </div>
</div>
<div class="overview-shortcuts">
    <a asp-page="/Admin/ManageAuthor"><i class="bi bi-person-badge" aria-hidden="true"></i><span>Tác giả<small>Thông tin & tiểu sử</small></span><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
    <a asp-page="/Admin/ManageNXB"><i class="bi bi-buildings" aria-hidden="true"></i><span>Nhà xuất bản<small>Đơn vị & liên hệ</small></span><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
    <a asp-page="/Admin/Tags"><i class="bi bi-tags" aria-hidden="true"></i><span>Thẻ sách<small>Kết nối các chủ đề</small></span><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
</div>
