@page
@model BookInfoFinder.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Người dùng";
    ViewData["Description"] = "Quản lý tài khoản, vai trò và quyền truy cập thư viện.";
}
@section PageActions { <button class="admin-button primary" id="userAdd" type="button"><i class="bi bi-plus-lg" aria-hidden="true"></i> Thêm người dùng</button> }
<section class="admin-panel">
    <div class="panel-heading slim"><h2>Tài khoản thư viện</h2><span class="table-meta" id="userTotal" role="status" aria-live="polite">Đang tải…</span></div>
    <form class="table-toolbar" id="userSearchForm" role="search">
        <label class="admin-search"><i class="bi bi-search" aria-hidden="true"></i><span class="visually-hidden">Tìm người dùng</span><input type="search" name="search" id="userSearch" placeholder="Tìm tên, tài khoản hoặc email…" autocomplete="off" /></label>
        <select name="role" id="userRole" aria-label="Lọc vai trò"><option value="">Tất cả vai trò</option><option value="Admin">Quản trị viên</option><option value="User">Người đọc</option></select>
        <select name="status" id="userStatus" aria-label="Lọc trạng thái"><option value="">Tất cả trạng thái</option><option value="1">Đang hoạt động</option><option value="0">Đã khóa</option></select>
        <button class="admin-button secondary" type="submit">Tìm kiếm</button><button class="admin-button text" type="button" id="userReset">Xóa bộ lọc</button>
    </form>
    <div id="adminUsersTable" aria-busy="true"><div class="admin-empty">Đang tải tài khoản…</div></div>
    <div class="table-footer"><span id="userSummary">Tài khoản thư viện</span><nav id="userPagination" class="admin-pagination" aria-label="Trang tài khoản"></nav></div>
</section>
<div class="modal fade admin-dialog" id="userEditor" tabindex="-1" aria-labelledby="userEditorTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><form class="modal-content" id="userEditorForm">
        <div class="modal-header"><h2 id="userEditorTitle" class="modal-title">Thêm người dùng</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng biểu mẫu"></button></div>
        <div class="modal-body">
            <div class="form-error" id="userFormError" role="alert" tabindex="-1" hidden></div>
            <div class="field-group"><label for="editUserName">Tên đăng nhập <span class="required">*</span></label><input name="userName" id="editUserName" required maxlength="30" autocomplete="off" spellcheck="false" placeholder="Ví dụ: nguoidoc…" /></div>
            <div class="field-group"><label for="editFullName">Họ và tên <span class="required">*</span></label><input name="fullName" id="editFullName" required maxlength="100" autocomplete="off" placeholder="Họ và tên người dùng…" /></div>
            <div class="field-group"><label for="editEmail">Email <span class="required">*</span></label><input name="email" id="editEmail" type="email" required maxlength="100" autocomplete="off" spellcheck="false" placeholder="Ví dụ: ban@example.com…" /></div>
            <div class="field-group" id="userPasswordField"><label for="editPassword">Mật khẩu <span class="required">*</span></label><input name="password" id="editPassword" type="password" minlength="6" maxlength="60" autocomplete="new-password" placeholder="Ít nhất 6 ký tự…" /></div>
            <div class="field-group"><label for="editRole">Vai trò</label><select name="roleStr" id="editRole"><option value="User">Người đọc</option><option value="Admin">Quản trị viên</option></select><small>Quản trị viên có quyền quản lý nội dung và tài khoản.</small></div>
        </div>
        <div class="modal-footer"><button type="button" class="admin-button secondary" data-bs-dismiss="modal">Hủy</button><button type="submit" class="admin-button primary" id="userSave">Thêm người dùng</button></div>
    </form></div>
</div>
@section Scripts { <script src="~/js/admin-users.js" asp-append-version="true"></script> }
