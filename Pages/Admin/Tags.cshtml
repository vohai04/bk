@page
@model BookInfoFinder.Pages.Admin.TagsModel
@{
    var definition = BookInfoFinder.Models.View.AdminCatalogDefinition.For("tags");
    ViewData["Title"] = definition.Title;
    ViewData["Description"] = definition.Description;
}
@section PageActions {
    <button type="button" class="admin-button primary" id="catalogAdd"><i class="bi bi-plus-lg" aria-hidden="true"></i> Thêm @definition.Singular</button>
}
<partial name="_CatalogWorkspace" model="definition" />
@section Scripts { <script src="~/js/admin-catalog.js" asp-append-version="true"></script> }
