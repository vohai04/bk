@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "/Index";
    var links = new[] {
        (Page: "/Index", Icon: "compass", Label: "Khám phá"),
        (Page: "/Favorites", Icon: "bookmark-heart", Label: "Sách yêu thích"),
        (Page: "/SearchHistory", Icon: "clock-history", Label: "Lịch sử tìm kiếm"),
        (Page: "/Notifications", Icon: "bell", Label: "Thông báo")
    };
}
<!DOCTYPE html>
<html lang="vi">
<head><partial name="_Head" /><link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/reader-pages.css" asp-append-version="true" /></head>
<body class="reader-body">
    <a class="skip-link" href="#mainContent">Đến nội dung chính</a>
    <nav class="icon-rail" aria-label="Điều hướng nhanh">
        <a class="rail-brand" asp-page="/Index" aria-label="BookInfoFinder"><i class="bi bi-book-half" aria-hidden="true"></i></a>
        @foreach (var link in links)
        {
            <a asp-page="@link.Page" class="rail-link @(currentPage == link.Page ? "active" : "")" aria-label="@link.Label" title="@link.Label"><i class="bi bi-@link.Icon" aria-hidden="true"></i></a>
        }
        <a class="rail-link rail-account" asp-page="/Account/Profile" aria-label="Hồ sơ"><i class="bi bi-person-circle" aria-hidden="true"></i></a>
    </nav>
    <aside class="reader-sidebar" id="workspaceSidebar" aria-label="Menu thư viện">
        <a class="workspace-brand" asp-page="/Index">BookInfoFinder<span>Không gian dành cho người đọc</span></a>
        <div class="sidebar-section-label">Thư viện của bạn</div>
        <nav class="workspace-nav" aria-label="Thư viện">
            @foreach (var link in links)
            {
                <a asp-page="@link.Page" class="@(currentPage == link.Page ? "active" : "")" aria-current="@(currentPage == link.Page ? "page" : null)">
                    <i class="bi bi-@link.Icon" aria-hidden="true"></i><span>@link.Label</span>
                    @if (link.Page == "/Notifications") { <span id="notificationCount" class="notification-badge" style="display:none"></span> }
                </a>
            }
        </nav>
        <div class="sidebar-section-label">Chọn một cuốn sách</div>
        <nav class="workspace-nav collection-nav" aria-label="Bộ sưu tập">
            <a asp-page="/Index" asp-route-filter="top-rated"><span class="collection-dot dot-purple"></span>Được đánh giá cao</a>
            <a asp-page="/Index" asp-route-filter="trending"><span class="collection-dot dot-orange"></span>Được yêu thích</a>
            <a asp-page="/Index" asp-route-sort="year"><span class="collection-dot dot-green"></span>Mới xuất bản</a>
        </nav>
        <div class="sidebar-note"><i class="bi bi-book" aria-hidden="true"></i><h2>Một cuốn sách hay,<br />một góc nhìn mới.</h2><p>Tìm kiếm, lưu lại và chia sẻ những cuốn sách bạn yêu thích.</p><a asp-page="/Favorites">Mở tủ sách của bạn <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a></div>
        <a class="sidebar-privacy" asp-page="/Privacy"><i class="bi bi-shield-check" aria-hidden="true"></i> Chính sách bảo mật</a>
    </aside>
    <div class="reader-workspace">
        <header class="workspace-topbar">
            <div class="topbar-location"><button id="workspaceMenuToggle" class="icon-button mobile-menu-toggle" type="button" aria-controls="workspaceSidebar" aria-expanded="false" aria-label="Mở menu thư viện"><i class="bi bi-list" aria-hidden="true"></i></button><span>Thư viện</span><i class="bi bi-chevron-right" aria-hidden="true"></i><strong>@ViewData["Title"]</strong></div>
            <div class="topbar-actions"><partial name="_UserMenu" /></div>
        </header>
        <main id="mainContent" class="reader-main" tabindex="-1">@RenderBody()</main>
        <footer class="workspace-footer"><span><i class="bi bi-book-half" aria-hidden="true"></i> BookInfoFinder</span><span>Đọc sách. Mở rộng thế giới.</span><a asp-page="/Privacy">Bảo mật</a></footer>
    </div>
    <button class="sidebar-backdrop" type="button" aria-label="Đóng menu" tabindex="-1" hidden></button>
    <partial name="_Feedback" /><partial name="_Chatbot" /><partial name="_Scripts" />
    <script src="~/js/chatbot.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
