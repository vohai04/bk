@model BookInfoFinder.Models.View.BookEditorViewModel
<form method="post" enctype="multipart/form-data" id="bookEditorForm" asp-antiforgery="true">
    @if (Model.IsEdit) { <input asp-for="Book.BookId" type="hidden" /><input asp-for="Book.ImageBase64" type="hidden" /> }
    <div class="book-editor">
        <section class="admin-panel">
            <div class="editor-fields">
                <h2 class="editor-section-title">Thông tin sách</h2>
                <div asp-validation-summary="All" class="editor-error field-wide" role="alert"></div>
                <div class="field-group field-wide"><label asp-for="Book.Title">Tên sách <span class="required">*</span></label><input asp-for="Book.Title" required maxlength="100" placeholder="Ví dụ: Những người khốn khổ…" autocomplete="off" /><span asp-validation-for="Book.Title" class="editor-error"></span></div>
                <div class="field-group"><label asp-for="Book.ISBN">ISBN <span class="required">*</span></label><input asp-for="Book.ISBN" required minlength="10" maxlength="13" pattern="(?:[0-9]{13}|[0-9]{9}[0-9Xx])" inputmode="numeric" placeholder="Ví dụ: 9780747532699…" autocomplete="off" /><small>10 hoặc 13 ký tự, không dùng dấu gạch nối.</small><span asp-validation-for="Book.ISBN" class="editor-error"></span></div>
                <div class="field-group"><label asp-for="Book.PublicationDate">Ngày xuất bản <span class="required">*</span></label><input asp-for="Book.PublicationDate" asp-format="{0:yyyy-MM-dd}" type="date" required /><span asp-validation-for="Book.PublicationDate" class="editor-error"></span></div>
                <div class="field-group"><label asp-for="Book.AuthorId">Tác giả <span class="required">*</span></label><select asp-for="Book.AuthorId" required><option value="">Chọn tác giả</option>@foreach (var author in Model.Authors) { <option value="@author.AuthorId">@author.Name</option> }</select><a class="field-help" asp-page="/Admin/ManageAuthor" target="_blank" rel="noopener">Thêm tác giả <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a><span asp-validation-for="Book.AuthorId" class="editor-error"></span></div>
                <div class="field-group"><label asp-for="Book.CategoryId">Thể loại <span class="required">*</span></label><select asp-for="Book.CategoryId" required><option value="">Chọn thể loại</option>@foreach (var category in Model.Categories) { <option value="@category.CategoryId">@category.Name</option> }</select><a class="field-help" asp-page="/Admin/Categories" target="_blank" rel="noopener">Thêm thể loại <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a><span asp-validation-for="Book.CategoryId" class="editor-error"></span></div>
                <div class="field-group field-wide"><label asp-for="Book.PublisherId">Nhà xuất bản <span class="required">*</span></label><select asp-for="Book.PublisherId" required><option value="">Chọn nhà xuất bản</option>@foreach (var publisher in Model.Publishers) { <option value="@publisher.PublisherId">@publisher.Name</option> }</select><a class="field-help" asp-page="/Admin/ManageNXB" target="_blank" rel="noopener">Thêm nhà xuất bản <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a><span asp-validation-for="Book.PublisherId" class="editor-error"></span></div>
                <h2 class="editor-section-title">Giới thiệu nội dung</h2>
                <div class="field-group field-wide"><label asp-for="Book.Description">Mô tả ngắn <span class="required">*</span></label><input asp-for="Book.Description" required maxlength="50" placeholder="Một dòng giới thiệu cuốn sách…" autocomplete="off" /><small>Tối đa 50 ký tự.</small><span asp-validation-for="Book.Description" class="editor-error"></span></div>
                <div class="field-group field-wide"><label asp-for="Book.Abstract">Tóm tắt <span class="required">*</span></label><textarea asp-for="Book.Abstract" required maxlength="200" rows="5" placeholder="Nội dung chính của cuốn sách…"></textarea><small>Tối đa 200 ký tự.</small><span asp-validation-for="Book.Abstract" class="editor-error"></span></div>
            </div>
            <div class="editor-savebar"><span>Thông tin có dấu * là bắt buộc.</span><div><a class="admin-button secondary" asp-page="/Admin/ManageBook">Hủy</a><button class="admin-button primary" type="submit" id="bookEditorSave"><i class="bi bi-check-lg" aria-hidden="true"></i> @(Model.IsEdit ? "Lưu thay đổi" : "Thêm sách")</button></div></div>
        </section>
        <aside class="editor-side" aria-label="Ảnh bìa và thẻ sách">
            <section class="admin-panel cover-upload"><img id="bookCoverPreview" src="@(string.IsNullOrEmpty(Model.Book.ImageBase64) ? "/images/default-book.svg" : Model.Book.ImageBase64)" alt="Xem trước ảnh bìa sách" width="130" height="195" data-cover-fallback /><label for="ImageFile">Ảnh bìa sách</label><input type="file" id="ImageFile" name="ImageFile" accept=".jpg,.jpeg,.png,.gif,.webp" /><small>JPG, PNG, GIF hoặc WebP. Tối đa 5 MB.</small><span id="coverError" class="editor-error" role="alert"></span></section>
            <section class="admin-panel editor-tags"><h2>Thẻ sách</h2><div class="tag-options">@foreach (var tag in Model.Tags) { <label><input type="checkbox" name="SelectedTagIds" value="@tag.TagId" checked="@Model.SelectedTagIds.Contains(tag.TagId)" />@tag.Name</label> }</div>@if (Model.Tags.Count == 0) { <p class="text-muted">Chưa có thẻ sách.</p> }<a class="field-help" asp-page="/Admin/Tags" target="_blank" rel="noopener">Quản lý thẻ sách <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a></section>
        </aside>
    </div>
</form>
