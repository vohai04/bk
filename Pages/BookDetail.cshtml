@page "{id:int}"
@model BookInfoFinder.Pages.BookDetailModel
@{ ViewData["Title"] = Model.Book.Title; var book = Model.Book; }
<div class="reader-page" id="bookDetail" data-book-id="@book.BookId">
    <a class="book-breadcrumb" asp-page="/Index"><i class="bi bi-arrow-left" aria-hidden="true"></i> Quay lại khám phá</a>
    <section class="book-detail-grid" aria-labelledby="bookTitle">
        <div class="detail-cover-frame"><img class="detail-cover" width="180" height="285" fetchpriority="high" data-cover="@book.ImageBase64" src="/images/default-book.svg" alt="Bìa sách @book.Title" /></div>
        <div class="book-overview">
            <p class="page-eyebrow">@book.CategoryName</p>
            <h1 id="bookTitle">@book.Title</h1>
            <p class="book-byline">Tác giả <button type="button" class="btn btn-link entity-detail" data-type="author" data-id="@book.AuthorId">@book.AuthorName</button></p>
            <div class="book-rating"><span class="rating-stars" aria-hidden="true">★</span><strong id="averageRating">@book.AverageRating.ToString("0.0")</strong><span id="ratingCount">@book.RatingCount đánh giá</span></div>
            <p class="detail-description">@book.Description</p>
            <button type="button" class="btn btn-primary" id="saveBookBtn"><i class="bi bi-bookmark-plus" aria-hidden="true"></i> Lưu vào tủ sách</button>
            <dl class="book-metadata">
                <div><dt>Nhà xuất bản</dt><dd><button type="button" class="btn btn-link entity-detail" data-type="publisher" data-id="@book.PublisherId">@book.PublisherName</button></dd></div>
                <div><dt>Thể loại</dt><dd><button type="button" class="btn btn-link entity-detail" data-type="category" data-id="@book.CategoryId">@book.CategoryName</button></dd></div>
                <div><dt>Năm xuất bản</dt><dd>@book.PublicationDate.Year</dd></div><div><dt>ISBN</dt><dd>@book.ISBN</dd></div>
            </dl>
            <div class="detail-tags">@foreach (var tag in book.Tags) { <a asp-page="/Index" asp-route-tag="@tag">@tag</a> }</div>
        </div>
    </section>
    <div class="detail-body-grid">
        <div>
            <section class="reader-panel" aria-labelledby="abstractHeading"><p class="page-eyebrow">Giữa những trang sách</p><h2 id="abstractHeading">Về cuốn sách này</h2><p class="book-abstract">@book.Abstract</p></section>
            <section class="reader-panel comments-panel" aria-labelledby="commentsHeading">
                <div class="comments-heading"><h2 id="commentsHeading">Bình luận &amp; đánh giá</h2><span id="commentCount"></span></div>
                @if (HttpContext.Session.GetString("UserId") != null)
                {
                    <form id="commentForm" class="comment-composer">
                        <label class="form-label" for="commentText">Bạn nghĩ gì về cuốn sách này?</label>
                        <textarea id="commentText" name="Comment" autocomplete="off" class="form-control" rows="3" maxlength="500" required placeholder="Chia sẻ cảm nhận của bạn…"></textarea>
                        <div class="composer-toolbar"><div class="rating-select"><label for="commentStar">Đánh giá</label><select id="commentStar" name="Star" class="form-select" required><option value="5">5 sao</option><option value="4">4 sao</option><option value="3">3 sao</option><option value="2">2 sao</option><option value="1">1 sao</option></select></div><button class="btn btn-primary" type="submit">Gửi bình luận</button></div>
                    </form>
                }
                else { <p class="reader-help"><a asp-page="/Account/Login">Đăng nhập</a> để đánh giá và cùng trò chuyện về sách.</p> }
                <div id="commentsList" aria-live="polite"><p class="reader-help">Đang tải bình luận…</p></div>
                <nav aria-label="Trang bình luận"><ul class="pagination" id="commentsPager"></ul></nav>
                <p class="reader-help">Ngày giờ hiển thị theo giờ Việt Nam (UTC+7).</p>
            </section>
        </div>
        <aside class="detail-reading-note"><i class="bi bi-book" aria-hidden="true"></i><h2>Đọc chậm lại.<br />Cảm nhận nhiều hơn.</h2><p>Lưu cuốn sách vào tủ sách để trở lại bất cứ lúc nào. Một vài dòng cảm nhận của bạn có thể giúp người đọc tiếp theo.</p></aside>
    </div>
</div>
<div class="modal fade" id="entityDetailModal" tabindex="-1" aria-labelledby="entityDetailTitle"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="modal-title" id="entityDetailTitle"></h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Đóng"></button></div><div class="modal-body" id="entityDetailContent"></div></div></div></div>
@section Scripts { <script src="~/js/book-detail.js" asp-append-version="true"></script> }
