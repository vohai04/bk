@page
@model BookInfoFinder.Pages.NotificationsModel
@{ ViewData["Title"] = "Thông báo"; }
<div class="reader-page"><div class="reader-heading"><div><p class="page-eyebrow">Kết nối cùng người đọc</p><h1>Thông báo</h1><p>@Model.UnreadCount thông báo chưa đọc · Những phản hồi dành cho bạn.</p></div>@if (Model.UnreadCount > 0) { <form method="post" asp-page-handler="ReadAll"><button class="btn btn-secondary" type="submit">Đánh dấu tất cả đã đọc</button></form> }</div><section class="reader-panel">
@if (Model.Items.Count == 0) { <div class="reader-empty"><i class="bi bi-bell" aria-hidden="true"></i><p>Bạn chưa có thông báo nào.</p></div> }
@foreach (var item in Model.Items) { var n = item.Notification;
<article class="reader-notification @(!n.IsRead ? "unread" : "")"><i class="bi bi-chat-square-text" aria-hidden="true"></i><div><h2>@if (item.TargetUrl != null) { <a href="@item.TargetUrl">@n.Title</a> } else { @n.Title }</h2><p>@n.Message</p><time datetime="@n.CreatedAt.ToString("O")"></time></div>@if (!n.IsRead) { <form method="post" asp-page-handler="Read"><input type="hidden" name="notificationId" value="@n.NotificationId" /><button class="btn btn-secondary" type="submit">Đã đọc</button></form> }</article>
}
</section>@if (Model.TotalPages > 1) { <nav aria-label="Trang thông báo"><ul class="pagination">@for (var p = Math.Max(1, Model.CurrentPage - 2); p <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); p++) { <li class="page-item @(p == Model.CurrentPage ? "active" : "")"><a class="page-link" asp-route-page="@p">@p</a></li> }</ul></nav> }</div>
