@page
@model BookInfoFinder.Pages.SearchHistoryModel
@{ ViewData["Title"] = "Dấu vết khám phá"; }
<div class="reader-page" id="readerCollection" data-kind="SearchHistory"><div class="reader-heading"><div><p class="page-eyebrow">Hành trình đọc sách</p><h1>Dấu vết khám phá</h1><p>Xem lại những từ khóa đã giúp bạn tìm thấy một cuốn sách hay.</p></div><button class="btn btn-secondary" id="clearHistoryBtn" type="button">Xóa toàn bộ lịch sử</button></div><div id="collectionList" class="reader-panel history-list" aria-live="polite"><p class="reader-help">Đang tải…</p></div><nav aria-label="Phân trang"><ul id="collectionPager" class="pagination"></ul></nav></div>
@section Scripts { <script src="~/js/reader-collections.js" asp-append-version="true"></script> }
