@page
@model BookInfoFinder.Pages.Account.ProfilePageModel
@{ ViewData["Title"] = "Hồ sơ"; var profile = Model.Profile; }
<div class="reader-page">
    <div class="reader-heading"><div><p class="page-eyebrow">Không gian cá nhân</p><h1>Hồ sơ của bạn</h1><p>Thông tin tài khoản và cài đặt bảo mật, trong một nơi.</p></div></div>
    <div class="profile-layout">
        <section class="reader-panel profile-identity"><partial name="_Avatar" model="@(new BookInfoFinder.Models.View.AvatarViewModel(profile.UserId, profile.UserName, profile.AvatarUrl, "profile-monogram"))" /><div><h2>@profile.UserName</h2><span class="profile-label">@(profile.Role == "Admin" ? "Quản trị viên" : "Người đọc")</span></div><div class="profile-avatar-actions"><button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#avatarModal">Đổi ảnh đại diện</button></div><button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#editProfileModal">Chỉnh sửa hồ sơ</button></section>
        <div><section class="reader-panel"><h2>Thông tin cá nhân</h2><p class="reader-subtitle">Giúp mọi người biết đến bạn qua những chia sẻ về sách.</p><dl class="profile-fields"><div><dt>Tên hiển thị</dt><dd id="profileFullName">@profile.FullName</dd></div><div><dt>Email</dt><dd id="profileEmail">@profile.Email</dd></div><div><dt>Ngày tham gia</dt><dd><time datetime="@profile.CreatedAt.ToString("O")"></time></dd></div><div><dt>Cập nhật gần nhất</dt><dd id="profileUpdatedAt">@if (profile.UpdatedAt.HasValue) { <time datetime="@profile.UpdatedAt.Value.ToString("O")"></time> } else { <span>Chưa cập nhật</span> }</dd></div></dl></section>
        <section class="reader-panel profile-security"><div><h2><i class="bi bi-shield-check" aria-hidden="true"></i> Bảo mật tài khoản</h2><p>Đổi mật khẩu khi bạn cần tăng cường bảo vệ tài khoản.</p></div><button class="btn btn-secondary" type="button" data-bs-toggle="modal" data-bs-target="#changePasswordModal">Đổi mật khẩu</button></section></div>
    </div>
</div>
<div class="modal fade" id="editProfileModal" tabindex="-1" aria-labelledby="editProfileTitle"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" id="editProfileForm" data-user-id="@profile.UserId"><div class="modal-header"><h2 class="modal-title" id="editProfileTitle">Chỉnh sửa hồ sơ</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Đóng"></button></div><div class="modal-body"><div class="mb-3"><label class="form-label" for="profileFullNameInput">Tên hiển thị</label><input class="form-control" id="profileFullNameInput" value="@profile.FullName" maxlength="100" autocomplete="name" required name="profileFullNameInput" /></div><div><label class="form-label" for="profileEmailInput">Email</label><input class="form-control" type="email" spellcheck="false" id="profileEmailInput" value="@profile.Email" maxlength="256" autocomplete="email" required name="profileEmailInput" /></div></div><div class="modal-footer"><button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Hủy</button><button class="btn btn-primary" type="submit" id="saveProfileBtn">Lưu thay đổi</button></div></form></div></div>
<div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordTitle"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" id="changePasswordForm" data-user-id="@profile.UserId"><div class="modal-header"><h2 class="modal-title" id="changePasswordTitle">Đổi mật khẩu</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Đóng"></button></div><div class="modal-body"><div class="mb-3"><label class="form-label" for="currentPassword">Mật khẩu hiện tại</label><input class="form-control" type="password" id="currentPassword" autocomplete="current-password" required name="currentPassword" /></div><div class="mb-3"><label class="form-label" for="newPassword">Mật khẩu mới</label><input class="form-control" type="password" id="newPassword" autocomplete="new-password" minlength="6" maxlength="100" required name="newPassword" /><p class="reader-help">Từ 6 đến 100 ký tự.</p></div><div><label class="form-label" for="confirmNewPassword">Xác nhận mật khẩu mới</label><input class="form-control" type="password" id="confirmNewPassword" autocomplete="new-password" minlength="6" maxlength="100" required name="confirmNewPassword" /></div></div><div class="modal-footer"><button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Hủy</button><button class="btn btn-primary" type="submit" id="savePasswordBtn">Đổi mật khẩu</button></div></form></div></div>

<div class="modal fade" id="avatarModal" tabindex="-1" aria-labelledby="avatarTitle">
    <div class="modal-dialog modal-dialog-centered"><form class="modal-content" id="avatarForm" enctype="multipart/form-data" data-user-id="@profile.UserId" data-avatar-url="@profile.AvatarUrl" data-initial="@profile.UserName.FirstOrDefault().ToString().ToUpperInvariant()">
        <div class="modal-header"><h2 class="modal-title" id="avatarTitle">Ảnh đại diện</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
        <div class="modal-body avatar-editor"><div class="avatar-preview" id="avatarPreview"><span class="avatar-initial"></span><img id="avatarPreviewImage" alt="Xem trước ảnh đại diện" width="144" height="144" hidden /></div>
            <label class="btn btn-secondary avatar-file-label" for="avatarFile">Chọn ảnh</label><input id="avatarFile" name="avatar" type="file" class="visually-hidden" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" />
            <p class="reader-help">JPG, PNG hoặc WebP, tối đa 2 MB. Ảnh sẽ được cắt vuông ở giữa.</p><p id="avatarFileName" class="reader-help"></p><p id="avatarError" class="text-danger" role="alert" hidden></p>
        </div>
        <div class="modal-footer"><button id="deleteAvatarBtn" class="btn btn-link text-danger me-auto" type="button" disabled="@(profile.AvatarUrl == null)">Xóa ảnh</button><button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Hủy</button><button id="uploadAvatarBtn" class="btn btn-primary" type="submit" disabled>Lưu ảnh</button></div>
    </form></div>
</div>

@section Scripts { <script src="~/js/profile.js" asp-append-version="true"></script> }
